{
  "name": "pokeclicker-desktop-acsrq",
  "version": "1.2.1",
  "description": "PokeClicker Desktop ACSRQ",
  "repository": {
    "type": "git",
    "url": "https://github.com/switchlove/Pokeclicker-desktop.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron ./",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:tux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --macos --publish never",
    "dist:mac:remote": "node build-mac.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": {
    "name": "SwitchLove",
    "email": "dev@switchlove.app"
  },
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1",
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.11"
  },
  "overrides": {
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "pokeclicker.desktop.acsrq",
    "productName": "PokeClicker ACSRQ",
    "artifactName": "PokeClicker-ACSRQ-${version}-${os}-${arch}.${ext}",
    "generateUpdatesFilesForAllChannels": true,
    "files": [
      "src/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "switchlove",
        "repo": "Pokeclicker-desktop",
        "channel": "latest",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.games",
      "compression": "maximum",
      "icon": "./build/icon_512x512.icns",
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        }
      ]
    },
    "dmg": {
      "background": "./build/DMG_Background.tiff",
      "icon": "./build/icon_512x512.icns",
      "iconSize": 112,
      "window": {
        "width": 680,
        "height": 380
      }
    },
    "linux": {
      "category": "Game",
      "compression": "maximum",
      "icon": "./build/icon_512x512.png",
      "target": "deb"
    },
    "deb": {
      "compression": "xz"
    }
  }
}
