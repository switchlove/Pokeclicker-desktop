{
    "name": "pokeclicker-desktop-acsrq-beta",
    "version": "1.2.0",
    "description": "PokeClicker Desktop ACSRQ Beta",
    "repository": {
        "type": "git",
        "url": "https://github.com/switchlove/Pokeclicker-desktop.git"
    },
    "main": "src/main.js",
    "scripts": {
        "start": "electron ./",
        "restore-src": "git restore --source=HEAD --staged --worktree -- src/pokeclicker-master && git clean -x -f -- src/pokeclicker-master",
        "dist:win32": "electron-builder --win --ia32",
        "dist:win64": "electron-builder --win --x64",
        "dist:winPort": "electron-builder --windows portable",
        "dist:tux": "electron-builder --linux",
        "dist:mac": "electron-builder --macos --x64",
        "dist:mac:arm": "electron-builder --macos --arm64",
        "dist:mac:universal": "electron-builder --macos --universal",
        "pub:32": "electron-builder --win --ia32 -p always",
        "pub:64": "electron-builder --win --x64 -p always",
        "release:stable": "npm version patch",
        "release:beta": "npm version prerelease --preid=beta",
        "release:alpha": "npm version prerelease --preid=alpha",
        "release:rc": "npm version prerelease --preid=rc",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "author": {
        "name": "SwitchLove",
        "email": "dev@switchlove.app"
    },
    "license": "ISC",
    "packageManager": "npm@11.12.1",
    "engines": {
        "node": "24.14.1",
        "npm": "11.12.1"
    },
    "dependencies": {
        "adm-zip": "^0.5.9",
        "discord-rpc": "^4.0.1",
        "electron-updater": "^6.3.0"
    },
    "devDependencies": {
        "electron": "^35.7.5",
        "electron-builder": "^26.8.1"
    },
    "build": {
        "appId": "pokeclicker.desktop.acsrq.beta",
        "productName": "PokeClicker ACSRQ Beta",
        "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
        "generateUpdatesFilesForAllChannels": true,
        "publish": [
            {
                "provider": "github",
                "owner": "switchlove",
                "repo": "Pokeclicker-desktop",
                "channel": "latest",
                "releaseType": "release"
            }
        ],
        "win": {
            "requestedExecutionLevel": "highestAvailable",
            "target": "nsis"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        },
        "mac": {
            "category": "public.app-category.games",
            "hardenedRuntime": true,
            "icon": "./build/icon_512x512.icns",
            "target": [
                { "target": "dmg", "arch": ["x64", "arm64"] }
            ]
        },
        "dmg": {
            "background": "./build/DMG_Background.tiff",
            "icon": "./build/icon_512x512.icns",
            "iconSize": 112,
            "window": {
                "width": 680,
                "height": 380
            }
        },
        "linux": {
            "category": "Game",
            "compression": "maximum",
            "icon": "./build/icon_512x512.png",
            "target": "deb"
        },
        "deb": {
            "compression": "xz"
        }
    }
}
