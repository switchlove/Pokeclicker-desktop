{
  "name": "pokeclicker-desktop-new-wave",
  "version": "1.2.1-beta.0",
  "description": "PokeClicker Desktop NewWave",
  "repository": {
    "type": "git",
    "url": "https://github.com/switchlove/Pokeclicker-desktop.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron ./",
    "dist:win32": "electron-builder --win --ia32 --publish never",
    "dist:win64": "electron-builder --win --x64 --publish never",
    "dist:winPort": "electron-builder --windows portable --publish never",
    "dist:tux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --macos --x64 --publish never",
    "dist:mac:arm": "electron-builder --macos --arm64 --publish never",
    "dist:mac:universal": "electron-builder --macos --universal --publish never",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": {
    "name": "SwitchLove",
    "email": "dev@switchlove.app"
  },
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "@xhayper/discord-rpc": "^1.3.4",
    "electron-updater": "^6.8.9"
  },
  "overrides": {
    "undici": "^8.6.0"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "pokeclicker.desktop.acsrq.beta",
    "productName": "PokeClicker ACSRQ Beta",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "generateUpdatesFilesForAllChannels": true,
    "publish": [
      {
        "provider": "github",
        "owner": "switchlove",
        "repo": "Pokeclicker-desktop",
        "channel": "beta",
        "releaseType": "prerelease"
      }
    ],
    "win": {
      "requestedExecutionLevel": "highestAvailable",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.games",
      "hardenedRuntime": true,
      "icon": "./build/icon_512x512.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "background": "./build/DMG_Background.tiff",
      "icon": "./build/icon_512x512.icns",
      "iconSize": 112,
      "window": {
        "width": 680,
        "height": 380
      }
    },
    "linux": {
      "category": "Game",
      "compression": "maximum",
      "icon": "./build/icon_512x512.png",
      "target": "deb"
    },
    "deb": {
      "compression": "xz"
    }
  }
}
